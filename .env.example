# [USER ACTION REQUIRED]
# Copy this file to .env and fill in your values before running the application.
# Command: copy .env.example .env   (Windows)  |  cp .env.example .env   (Linux/Mac)

# Flask session signing key — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
HASHGUARD_SECRET_KEY=your-secret-key-here

# SMTP server settings (Gmail example shown below)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

# [USER ACTION REQUIRED] Your email account credentials for sending OTP emails
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
